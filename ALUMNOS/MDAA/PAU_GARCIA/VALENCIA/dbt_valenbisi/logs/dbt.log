  create  table "valenbisi_db"."public"."marts_horas_pico_por_estacion__dbt_tmp"
  
  
    as
  
  (
    with variaciones_hora as (
    select
        e.numero_estacion,
        extract(hour from e.momento_medicion) as hora,
        avg(e.variacion_bicis) as avg_variacion_bicis
    from "valenbisi_db"."public"."int_evolucion_temporal" e
    group by e.numero_estacion, extract(hour from e.momento_medicion)
),

-- Calculamos el valor máximo y mínimo de variación por estación
max_min_variacion as (
    select
        numero_estacion,
        max(avg_variacion_bicis) as max_variacion,
        min(avg_variacion_bicis) as min_variacion
    from variaciones_hora
    group by numero_estacion
),

-- Seleccionamos las horas donde ocurre la variación máxima y mínima
horas_pico as (
    select
        v.numero_estacion,
        string_agg(cast(v.hora as text), ', ') as hora_pico_entrada,
        string_agg(cast(v2.hora as text), ', ') as hora_pico_salida
    from variaciones_hora v
    join max_min_variacion mm
      on v.numero_estacion = mm.numero_estacion
     and v.avg_variacion_bicis = mm.max_variacion
    left join variaciones_hora v2
      on v.numero_estacion = v2.numero_estacion
     and v2.avg_variacion_bicis = mm.min_variacion
    group by v.numero_estacion
),

-- Calculamos métricas agregadas por estación desde int_ocupacion
metrics as (
    select
        i.numero_estacion,
        i.nombre_estacion,
        avg(i.bicicletas_disponibles) as avg_bicis,
        avg(i.huecos_disponibles) as avg_huecos,
        avg(i.capacidad_total - i.huecos_disponibles) as avg_ocupacion,
        stddev(i.bicicletas_disponibles) as std_bicis,
        stddev(i.huecos_disponibles) as std_huecos,
        avg(case when i.situacion_ocupacion in ('vacía','casi vacía') then 1.0 else 0 end) as pct_vacia,
        avg(case when i.situacion_ocupacion in ('llena','casi llena') then 1.0 else 0 end) as pct_llena
    from "valenbisi_db"."public"."int_ocupacion" i
    group by i.numero_estacion, i.nombre_estacion
)

select
    m.numero_estacion,
    m.nombre_estacion,
    m.avg_bicis,
    m.avg_huecos,
    m.avg_ocupacion,
    m.std_bicis,
    m.std_huecos,
    m.pct_vacia,
    m.pct_llena,
    h.hora_pico_entrada,
    h.hora_pico_salida
from metrics m
join horas_pico h
on m.numero_estacion = h.numero_estacion
order by m.numero_estacion;
  );
  
