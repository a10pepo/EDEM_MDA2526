[0m00:06:41.259525 [debug] [Thread-4 (]: On model.dbt_valenbisi.int_last_update: /* {"app": "dbt", "dbt_version": "1.11.0rc1", "profile_name": "dbt_valenbisi", "target_name": "dev", "node_id": "model.dbt_valenbisi.int_last_update"} */

  create view "valenbisi_db"."public"."int_last_update__dbt_tmp"
    
    
  as (
    with base as (

    -- Partimos del staging
    select *
    from "valenbisi_db"."public"."staging_valenbisi"

),

ordered as (

    select
        *,
        row_number() over (
            partition by numero_estacion
            order by momento_medicion desc
        ) as rn
    from base
),

last_update as (

    select
        id,
        numero_estacion,
        nombre_estacion,
        latitud,
        longitud,
        bicicletas_disponibles,
        huecos_disponibles,
        estado_estacion,
        capacidad_total,
        fecha_medicion,
        hora_medicion,
        momento_medicion,
        ultima_consulta
    from ordered
    where rn = 1
)

select *
from last_update
  );
