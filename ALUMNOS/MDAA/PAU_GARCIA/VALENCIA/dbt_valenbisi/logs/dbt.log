  create  table "valenbisi_db"."public"."marts_horas_pico_por_estacion__dbt_tmp"
  
  
    as
  
  (
    with variaciones_hora as (
    select
        numero_estacion,
        extract(hour from momento_medicion) as hora,
        avg(variacion_bicis) as avg_variacion_bicis
    from "valenbisi_db"."public"."int_evolucion_temporal"
    group by numero_estacion, extract(hour from momento_medicion)
),

bicis_hora as (
    select
        numero_estacion,
        extract(hour from momento_medicion) as hora,
        avg(bicicletas_disponibles) as avg_bicis
    from "valenbisi_db"."public"."int_ocupacion"
    group by numero_estacion, extract(hour from momento_medicion)
),

huecos_hora as (
    select
        numero_estacion,
        extract(hour from momento_medicion) as hora,
        avg(huecos_disponibles) as avg_huecos
    from "valenbisi_db"."public"."int_ocupacion"
    group by numero_estacion, extract(hour from momento_medicion)
),

-- Horas pico resumidas por estación
horas_pico as (
    select
        v.numero_estacion,
        string_agg(cast(v.hora as text), ', ') as hora_max_variacion,
        string_agg(cast(b.hora as text), ', ') as hora_max_bicis,
        string_agg(cast(h.hora as text), ', ') as hora_max_huecos
    from variaciones_hora v
    join (select numero_estacion, max(avg_variacion_bicis) as max_var from variaciones_hora group by numero_estacion) mv
    on v.numero_estacion = mv.numero_estacion and v.avg_variacion_bicis = mv.max_var
    join bicis_hora b
    on v.numero_estacion = b.numero_estacion
    and b.avg_bicis = (select max(avg_bicis) from bicis_hora bh where bh.numero_estacion = b.numero_estacion)
    join huecos_hora h
    on v.numero_estacion = h.numero_estacion
    and h.avg_huecos = (select max(avg_huecos) from huecos_hora hh where hh.numero_estacion = h.numero_estacion)
    group by v.numero_estacion
),

-- Métricas generales por estación
metrics as (
    select
        numero_estacion,
        nombre_estacion,
        avg(bicicletas_disponibles) as avg_bicis,
        avg(huecos_disponibles) as avg_huecos,
        avg(case when situacion_ocupacion in ('vacía','casi vacía') then 1.0 else 0 end) as pct_vacia,
        avg(case when situacion_ocupacion in ('llena','casi llena') then 1.0 else 0 end) as pct_llena
    from "valenbisi_db"."public"."int_ocupacion"
    group by numero_estacion, nombre_estacion
)

select
    m.numero_estacion,
    m.nombre_estacion,
    m.avg_bicis,
    m.avg_huecos,
    m.pct_vacia,
    m.pct_llena,
    h.hora_max_variacion,
    h.hora_max_bicis,
    h.hora_max_huecos
from metrics m
join horas_pico h
on m.numero_estacion = h.numero_estacion
order by m.numero_estacion
  );
  
