),

estado_actual as (
    select distinct on (l.numero_estacion)
        l.numero_estacion,
        l.nombre_estacion,
        l.latitud,
        l.longitud,
        o.bicicletas_disponibles,
        o.huecos_disponibles,
        o.capacidad_total,
        o.capacidad_real,
        o.no_disponibles,
        o.situacion_ocupacion,
