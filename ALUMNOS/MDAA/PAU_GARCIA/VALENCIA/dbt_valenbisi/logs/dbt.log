  create  table "valenbisi_db"."public"."marts_estaciones_conflictivas__dbt_tmp"
  
  
    as
  
  (
    with base as (

    select *
    from "valenbisi_db"."public"."int_ocupacion"

),

metrics as (

    select
        numero_estacion,
        nombre_estacion,
        capacidad_total,

        -- Porcentaje de tiempo cada estación estuvo vacía
        avg(case when situacion_estacion = 'vacía' then 1.0 else 0 end) as pct_tiempo_vacia,

        -- Porcentaje de tiempo casi vacía
        avg(case when situacion_estacion = 'casi vacía' then 1.0 else 0 end) as pct_tiempo_casi_vacia,

        -- Porcentaje de tiempo llena
        avg(case when situacion_estacion = 'llena' then 1.0 else 0 end) as pct_tiempo_llena,

        -- Porcentaje de tiempo casi llena
        avg(case when situacion_estacion = 'casi llena' then 1.0 else 0 end) as pct_tiempo_casi_llena,

        -- Porcentaje de tiempo fuera de servicio
        avg(case when estado_estacion != 'Operativa' then 1.0 else 0 end) as pct_tiempo_fuera_servicio,

        -- Variabilidad en bicicletas disponibles
        stddev(bicicletas_disponibles) as std_bicis_disponibles,

        -- Variabilidad en huecos disponibles
        stddev(huecos_disponibles) as std_huecos_disponibles

    from base
    group by numero_estacion, nombre_estacion, latitud, longitud, capacidad_total

),

ranked as (

    select *,
        -- Ranking de “conflictividad”: combina vacía/llena/variabilidad
        pct_tiempo_vacia + pct_tiempo_casi_vacia + pct_tiempo_llena + pct_tiempo_casi_llena + pct_tiempo_fuera_servicio
            + (std_bicis_disponibles / nullif(capacidad_total,0)) as conflict_score
    from metrics

)

select *
from ranked
order by conflict_score desc
  );
  
