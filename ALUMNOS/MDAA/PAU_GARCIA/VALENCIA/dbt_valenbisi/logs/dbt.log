  create view "valenbisi_db"."public"."int_ocupacion__dbt_tmp"
    
    
  as (
    with base as (

    -- Partimos directamente del staging
    select * 
    from "valenbisi_db"."public"."staging_valenbisi"

),

ocupacion as (

    select
        id,
        numero_estacion,
        nombre_estacion,
        bicicletas_disponibles,
        huecos_disponibles,
        estado_estacion,
        capacidad_total,

        bicicletas_disponibles * 1.0 / capacidad_total as porcentaje_bicis_disponibles,
        huecos_disponibles * 1.0 / capacidad_total as porcentaje_huecos_disponibles,
        huecos_disponibles + bicicletas_disponibles as capacidad_real,
        capacidad_total - capacidad_real as no_disponibles
    

        
        case
            when capacidad_real = 0 then 'desconocida'  
            when porcentaje_bicis_disponibles = 1 then 'llena'
            when porcentaje_bicis_disponibles >= 0.75 then 'casi llena'
            when porcentaje_bicis_disponibles >= 0.50 then 'medio llena'
            when porcentaje_bicis_disponibles >= 0.25 then 'medio vacía'
            when porcentaje_bicis_disponibles >= 0.01 then 'casi vacía'
            when porcentaje_bicis_disponibles = 0 then 'vacía'
            else 'desconocida'
        end as situacion_ocupacion

    from base
)

select * from ocupacion
  );
