e": null, "failures": null, "unique_id": "model.Jorge_DBT.stg_ventas", "compiled": true, "compiled_code": "with source as (\n    select * from \"dev\".\"main\".\"raw_ventas\"\n),\nrenamed as (\n    select\n        id_ticket as venta_id,\n        id_socio as socio_id,\n        id_producto as producto_id,\n        fecha_compra,\n        cantidad,\n        estado\n    from source\n)\nselect * from renamed", "relation_name": "\"dev\".\"main\".\"stg_ventas\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-11-25T09:22:06.382952Z", "completed_at": "2025-11-25T09:22:06.402069Z"}, {"name": "execute", "started_at": "2025-11-25T09:22:06.404560Z", "completed_at": "2025-11-25T09:22:06.404592Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.026625871658325195, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.Jorge_DBT.finanzas_por_marca", "compiled": true, "compiled_code": "with ventas as (\n    select * from \"dev\".\"main\".\"stg_ventas\"\n),\nproductos as (\n    select * from \"dev\".\"main\".\"stg_productos\"\n),\njoined as (\n    select\n        p.marca,\n        p.categoria,\n        sum(v.cantidad) as total_unidades_vendidas,\n        sum(v.cantidad * p.precio_venta) as facturacion_total,\n        sum(v.cantidad * p.beneficio_unitario) as beneficio_total\n    from ventas v\n    join productos p using (producto_id)\n    where v.estado = 'completado' -- Filtramos devoluciones\n    group by 1, 2\n)\nselect * from joined\norder by facturacion_total desc", "relation_name": "\"dev\".\"main\".\"finanzas_por_marca\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-11-25T09:22:06.414656Z", "completed_at": "2025-11-25T09:22:06.435258Z"}, {"name": "execute", "started_at": "2025-11-25T09:22:06.437924Z", "completed_at": "2025-11-25T09:22:06.437955Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.028293848037719727, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.Jorge_DBT.ranking_socios", "compiled": true, "compiled_code": "with socios as (\n    select * from \"dev\".\"main\".\"stg_socios\"\n),\nventas as (\n    select * from \"dev\".\"main\".\"stg_ventas\"\n),\nproductos as (\n    select * from \"dev\".\"main\".\"stg_productos\"\n),\nmetricas_socio as (\n    select\n        v.socio_id,\n        count(distinct v.venta_id) as num_compras,\n        sum(v.cantidad * p.precio_venta) as total_gastado_euros\n    from ventas v\n    join productos p using (producto_id)\n    where v.estado = 'completado'\n    group by 1\n)\nselect\n    s.socio_id,\n    s.nombre,\n    s.equipo_favorito,\n    coalesce(m.total_gastado_euros, 0) as gasto_total,\n    case \n        when m.total_gastado_euros > 200 then 'Super VIP'\n        when m.total_gastado_euros > 100 then 'VIP'\n        else 'Standard'\n    end as clasificacion_actual\nfrom socios s\nleft join metricas_socio m using (socio_id)\norder by gasto_total desc", "relation_name": "\"dev\".\"main\".\"ranking_socios\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-11-25T09:22:06.449156Z", "completed_at": "2025-11-25T09:22:06.483725Z"}, {"name": "execute", "started_at": "2025-11-25T09:22:06.486844Z", "completed_at": "2025-11-25T09:22:06.486877Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.04287600517272949, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.Jorge_DBT.not_null_ranking_socios_socio_id.2e516f76cc", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect socio_id\nfrom \"dev\".\"main\".\"ranking_socios\"\nwhere socio_id is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-11-25T09:22:06.496706Z", "completed_at": "2025-11-25T09:22:06.522278Z"}, {"name": "execute", "started_at": "2025-11-25T09:22:06.525007Z", "completed_at": "2025-11-25T09:22:06.52