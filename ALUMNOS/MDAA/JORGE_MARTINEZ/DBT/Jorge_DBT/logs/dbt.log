  create view "dev"."main"."ventas_por_cliente__dbt_tmp" as (
    with clientes as (
    select * from "dev"."main"."stg_clientes"
),
pedidos as (
    select * from "dev"."main"."stg_pedidos"
),
final as (
    select
        c.cliente_id,
        c.nombre,
        c.segmento_cliente,
        count(p.pedido_id) as numero_pedidos,
        -- Sumamos el dinero solo si el pedido está completado
        sum(case when p.estado = 'completado' then p.total_euros else 0 end) as valor_total_ventas
    from clientes c
    left join pedidos p using (cliente_id)
    group by 1, 2, 3
)
select * from final
  );

