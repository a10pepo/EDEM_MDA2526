def fetch_data_summary(retries=10, delay=2):
    for attempt in range(retries):
        try:
            with psycopg.connect(**DB_CONFIG) as conn:
                with conn.cursor() as cur:
                    cur.execute(f"SELECT metric, value FROM {TABLE_NAME};")
                    rows = cur.fetchall()
