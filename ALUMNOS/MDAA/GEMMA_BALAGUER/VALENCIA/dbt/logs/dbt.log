  create  table "pruebadb"."public"."int_valenbisi_time__dbt_tmp"
  
  
    as
  
  (
    

SELECT
    number,
    address,
    updated_at::date AS date,
    AVG(available) AS avg_available,
    AVG(free) AS avg_free,
