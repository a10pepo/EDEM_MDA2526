# --- Base de datos ---
# En local/EC2 apunta al servicio "db" de docker-compose.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/ecommerce

# --- AWS / S3 ---
AWS_REGION=eu-west-1
S3_BUCKET_NAME=ecommerce-ropa-media
# Vacío en AWS: el IAM Instance Role provee las credenciales automáticamente.
# Rellénalo SOLO para pruebas locales contra S3 real (no recomendado).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Segundos de validez de las URLs prefirmadas.
S3_PRESIGN_EXPIRATION=3600

# --- App ---
APP_ENV=local
