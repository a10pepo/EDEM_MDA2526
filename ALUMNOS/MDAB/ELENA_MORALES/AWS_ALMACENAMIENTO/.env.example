# Ejemplo de configuración. Copia a .env y ajusta los valores.
# El .env NO se sube a git (añádelo a .gitignore).

# --- Local con Postgres en Docker (docker compose) ---
DATABASE_URL=postgresql+psycopg://sephora:sephora_pass@db:5432/sephora

# --- AWS RDS (Postgres): pega el endpoint de tu instancia RDS ---
# DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASENA@mi-instancia.xxxxxx.eu-west-1.rds.amazonaws.com:5432/sephora

# --- Local sin Docker, cero configuración (SQLite) ---
# Si no defines DATABASE_URL, la app usa SQLite en ./sephora_local.db

# --- AWS S3 para subir exportaciones ---
# AWS_ACCESS_KEY_ID=tu_access_key
# AWS_SECRET_ACCESS_KEY=tu_secret_key
# AWS_DEFAULT_REGION=eu-west-1
# S3_BUCKET_NAME=tu-bucket
# S3_PREFIX=exports
