11-29T11:12:04.090371Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.005970478057861328, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.proyecto_elena.staging_shootouts", "compiled": true, "compiled_code": "with source as (\n    select * from \"dev\".\"main\".\"shootouts\"\n),\nrenamed as (\n    select\n        cast(\"date\" as date) as match_date,\n        home_team,\n        away_team,\n        winner\n    from source\n)\nselect * from renamed", "relation_name": "\"dev\".\"main\".\"staging_shootouts\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-11-29T11:12:04.092497Z", "completed_at": "2025-11-29T11:12:04.096764Z"}, {"name": "execute", "started_at": "2025-11-29T11:12:04.097294Z", "completed_at": "2025-11-29T11:12:04.097303Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0057675838470458984, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.proyecto_elena.top_scorers", "compiled": true, "compiled_code": "-- Este modelo responde a la pregunta: \n-- \"\u00bfQui\u00e9nes son los m\u00e1ximos goleadores de la historia y cu\u00e1ntos penaltis han marcado?\".\n\nwith goals as (\n    select * from \"dev\".\"main\".\"staging_goalscorers\"\n)\n\nselect\n    scorer as player_name,\n    team as national_team,\n    count(*) as total_goals,\n    sum(case when penalty = TRUE then 1 else 0 end) as penalty_goals\nfrom goals\n-- Exclude own goals (goals scored against themselves)\nwhere own_goal = FALSE\ngroup by 1, 2\norder by total_goals desc", "relation_name": "\"dev\".\"main\".\"top_scorers\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-11-29T11:12:04.099226Z", "completed_at": "2025-11-29T11:12:04.118276Z"}, {"name": "execute", "started_at": "2025-11-29T11:12:04.119054Z", "completed_at": "2025-11-29T11:12:04.119063Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.02066969871520996, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.proyecto_elena.not_null_staging_goalscorers_match_date.8d1bbf4cbb", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect match_date\nfrom \"dev\".\"main\".\"staging_goalscorers\"\nwhere match_date is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-11-29T11:12:04.121057Z", "completed_at": "2025-11-29T11:12:04.125546Z"}, {"name": "execute", "started_at": "2025-11-29T11:12:04.126062Z", "completed_at": "2025-11-29T11:12:04.126070Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.005913496017456055, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.proyecto_elena.team_stats", "compiled": true, "compiled_code": "with matches as (\n    select * from \"dev\".\"main\".\"staging_results\"\n),\n\n-- 1. Calculate stats when playing as HOME team\nhome_stats as (\n    select\n        home_team as team,\n        count(*) as games_played,\n        -- Win logic: Home Score > Away Score\n        sum(case when home_score > away_score then 1 else 0 end) as wins,\n        sum(home_score) as goals_for\n    from matches\n    group by 1\n),\n\n-- 2. Calculate stats when playing as AWAY team\naway_stats as (\n    select\n        away_team as team,\n        count(*) as games_played,\n        -- Win logic: Away Score > Home Score\n        sum(case when away_score > home_score then 1 else 0 end) as wins,\n        sum(away_score) as goals_for\n    from matches\n    group by 1\n),\n\n-- 3. Join both sides to get total stats\nfinal_stats as (\n    select\n        coalesce(h.team, a.team) as team,\n        (coalesce(h.games_played, 0) + coalesce(a.games_played, 0)) as total_games,\n        (coalesce(h.wins, 0) + coalesce(a.wins, 0)) as total_wins,\n        (coalesce(h.goals_for, 0) + coalesce(a.goals_for, 0)) as total_goals\n    from home_stats h\n    full outer join away_stats a on h.team = a.team\n)\n\nselect * from final_stats\norder by total_wins desc", "relation_name": "\"dev\".\"main\".\"team_stats\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-11-29T11:12:04.128093Z", "completed_at": "2025-11-29T11:12:04.137172Z"}, {"name": "execute", "started_at": "2025-11-29T11:12:04.137893Z", "completed_at": "2025-11-29T11:12:04.137901Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.010723590850830078, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.proyecto_elena.not_null_staging_results_away_team.14eca074c5", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect away_team\nfrom \"dev\".\"main\".\"staging_results\"\nwhere away_team is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-11-29T11:12:04.139813Z", "completed_at": "2025-11-29T11:12:04.145860Z"}, {"name": "execute", "started_at": "2025-11-29T11:12:04.146399Z", "completed_at": "2025-11-29T11:12:04.146407Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0074274539947509766, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.proyecto_elena.not_null_staging_results_home_team.8d4c366038", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect home_team\nfrom \"dev\".\"main\".\"staging_results\"\nwhere home_team is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-11-29T11:12:04.148647Z", "completed_at": "2025-11-29T11:12:04.205237Z"}, {"name": "execute", "started_at": "2025-11-29T11:12:04.205952Z", "completed_at": "2025-11-29T11:12:04.205964Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.058507680892944336, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.proyecto_elena.not_null_staging_results_match_date.eee894eca3", "compiled": true, "compiled_code