# Set to true to use DynamoDB Local instead of real AWS
USE_LOCAL_DYNAMODB=true
# Endpoint for DynamoDB Local (docker maps port 4566 → 8000 inside container)
DYNAMODB_ENDPOINT=http://localhost:4566

# AWS credentials (only needed for real AWS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# DynamoDB table names
PRODUCTS_TABLE=zara_products
TICKETS_TABLE=zara_tickets
CUSTOMERS_TABLE=zara_customers

# Data lake (S3 + Glue) — used by aws/load_lake.py
S3_BUCKET=zara-datalake-edem2526
GLUE_DATABASE=zara_db