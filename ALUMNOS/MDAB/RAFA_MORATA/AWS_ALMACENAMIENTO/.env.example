# =========================================================================
# Copia este fichero a .env y rellena los valores.
# En EC2 lo ideal es NO poner claves AWS aquí, sino usar un IAM Role.
# =========================================================================

# Región de AWS para todos los servicios.
# Se definen las dos porque distintas librerías leen una u otra.
AWS_REGION=eu-west-1
AWS_DEFAULT_REGION=eu-west-1

# --- Credenciales AWS (solo para ejecución local; en EC2 usar IAM Role) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Base de datos transaccional: PostgreSQL en RDS ---
# Para pruebas locales con docker-compose: PG_HOST=postgres
PG_HOST=localhost
PG_PORT=5432
PG_DB=aviation
PG_USER=postgres
PG_PASSWORD=postgres

# --- Base de datos analítica: Redshift ---
RS_HOST=
RS_PORT=5439
RS_DB=analytics
RS_USER=admin
RS_PASSWORD=

# --- Data lakehouse: Iceberg + S3 + Glue ---
S3_BUCKET=
GLUE_DATABASE=aviation_lakehouse
# Si se deja vacío se calcula como s3://$S3_BUCKET/warehouse
ICEBERG_WAREHOUSE=
